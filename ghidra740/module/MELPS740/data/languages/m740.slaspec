# SLEIGH specification for the Mitsubishi MELPS 740 core of the M50734 (Dolphin Apollo 2).
# Derived from Ghidra's 6502.slaspec (Apache License 2.0). The semantics follow the project's oracle,
# src/cpu740/cpu740.c, and ghidra740\validate.bat checks them against it.
# Not modelled:
#   - decimal arithmetic (D is only stored);
#   - T-flag addressing (T is only stored; the firmware never sets it);
#   - stack-page wrap (SP = $01xx, and only S, its low byte, is meant to move: keep S clear of $00/$FF).

define endian=little;
define alignment=1;

define space RAM      type=ram_space      size=2  default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ A X Y ];
define register offset=0x20 size=2 [ PC SP ];
define register offset=0x20 size=1 [ PCL PCH S SH ];
define register offset=0x30 size=1 [ N V T B D I Z C ];

define token opbyte (8)
   op   = (0,7)
   aaa  = (5,7)
   bitn = (5,7) dec
   bbb  = (2,4)
   cc   = (0,1)
;

define token data8 (8)
   imm8 = (0,7)
   rel  = (0,7) signed
;

define token data8b (8)
   zp2  = (0,7)
   rel2 = (0,7) signed
;

define token data16 (16)
   imm16 = (0,15)
;

define pcodeop wait;
define pcodeop stop;
define pcodeop software_interrupt;

macro resultFlags(value) {
   Z = (value == 0);
   N = (value s< 0);
}

macro addWithCarry(operand) {
   local sum:2 = zext(A) + zext(operand) + zext(C);
   local r:1 = sum:1;
   V = ((~(A ^ operand) & (A ^ r)) & 0x80) != 0;
   C = sum > 0xff;
   A = r;
   resultFlags(A);
}

macro push8(v) {
   *:1 SP = v;
   SP = SP - 1;
}

macro pull8(v) {
   SP = SP + 1;
   v = *:1 SP;
}

# cpu740 pushes the high byte at S, the low byte at S-1, and leaves S-2.
macro push16(v) {
   SP = SP - 1;
   *:2 SP = v;
   SP = SP - 1;
}

macro pull16(v) {
   SP = SP + 1;
   v = *:2 SP;
   SP = SP + 1;
}

macro packP(r) {
   r = (N << 7) | (V << 6) | (T << 5) | (B << 4) | (D << 3) | (I << 2) | (Z << 1) | C;
}

# PLP/RTI: B always reads back as 1 (cpu740 ORs it in).
macro unpackP(r) {
   N = (r >> 7) & 1;
   V = (r >> 6) & 1;
   T = (r >> 5) & 1;
   B = 1;
   D = (r >> 3) & 1;
   I = (r >> 2) & 1;
   Z = (r >> 1) & 1;
   C = r & 1;
}

################################################################
# Operand subtables
################################################################

REL:  reloc is rel  [ reloc = (inst_next + rel) & 0xffff; ]  { export *:2 reloc; }
REL2: reloc is rel2 [ reloc = (inst_next + rel2) & 0xffff; ] { export *:2 reloc; }

ADDR16: imm16  is imm16                        { export *:1 imm16; }
SPG:    spg    is imm8 [ spg = 0xff00 | imm8; ] { export *:1 spg; }
ZP:     imm8   is imm8                         { export *:1 imm8; }
ZP2:    zp2    is zp2                          { export *:1 zp2; }

# cc=1 group (ORA AND EOR ADC STA LDA CMP SBC). Indirect pointers wrap within page zero.
OP1: "#"imm8   is bbb=2; imm8         { tmp:1 = imm8; export tmp; }
OP1: imm8      is bbb=1; imm8         { export *:1 imm8; }
OP1: imm8,X    is bbb=5 & X; imm8     { tmp:2 = zext(imm8 + X); export *:1 tmp; }
OP1: imm16     is bbb=3; imm16        { export *:1 imm16; }
OP1: imm16,X   is bbb=7 & X; imm16    { tmp:2 = imm16 + zext(X); export *:1 tmp; }
OP1: imm16,Y   is bbb=6 & Y; imm16    { tmp:2 = imm16 + zext(Y); export *:1 tmp; }
OP1: (imm8,X)  is bbb=0 & X; imm8     {
   local zp:1 = imm8 + X;
   local lo:2 = zext(zp);
   zp = zp + 1;
   local hi:2 = zext(zp);
   local l:1 = *:1 lo;
   local h:1 = *:1 hi;
   local ea:2 = (zext(h) << 8) | zext(l);
   export *:1 ea;
}
OP1: (imm8),Y  is bbb=4 & Y; imm8     {
   local zp:1 = imm8;
   local lo:2 = zext(zp);
   zp = zp + 1;
   local hi:2 = zext(zp);
   local l:1 = *:1 lo;
   local h:1 = *:1 hi;
   local ea:2 = ((zext(h) << 8) | zext(l)) + zext(Y);
   export *:1 ea;
}

# Read-modify-write and register-compare group (no Y-indexed modes).
OP2: "#"imm8   is bbb=0; imm8         { tmp:1 = imm8; export tmp; }
OP2: imm8      is bbb=1; imm8         { export *:1 imm8; }
OP2: A         is bbb=2 & A           { export A; }
OP2: imm16     is bbb=3; imm16        { export *:1 imm16; }
OP2: imm8,X    is bbb=5 & X; imm8     { tmp:2 = zext(imm8 + X); export *:1 tmp; }
OP2: imm16,X   is bbb=7 & X; imm16    { tmp:2 = imm16 + zext(X); export *:1 tmp; }

LDXOP: "#"imm8 is bbb=0; imm8         { tmp:1 = imm8; export tmp; }
LDXOP: imm8    is bbb=1; imm8         { export *:1 imm8; }
LDXOP: imm16   is bbb=3; imm16        { export *:1 imm16; }
LDXOP: imm8,Y  is bbb=5 & Y; imm8     { tmp:2 = zext(imm8 + Y); export *:1 tmp; }
LDXOP: imm16,Y is bbb=7 & Y; imm16    { tmp:2 = imm16 + zext(Y); export *:1 tmp; }

STXOP: imm8    is bbb=1; imm8         { export *:1 imm8; }
STXOP: imm16   is bbb=3; imm16        { export *:1 imm16; }
STXOP: imm8,Y  is bbb=5 & Y; imm8     { tmp:2 = zext(imm8 + Y); export *:1 tmp; }

################################################################
# 6502 base instructions
################################################################

:ADC OP1  is (cc=1 & aaa=3) ... & OP1          { local v = OP1; addWithCarry(v); }
:SBC OP1  is (cc=1 & aaa=7) ... & OP1          { local v = ~OP1; addWithCarry(v); }
:AND OP1  is (cc=1 & aaa=1) ... & OP1          { A = A & OP1; resultFlags(A); }
:ORA OP1  is (cc=1 & aaa=0) ... & OP1          { A = A | OP1; resultFlags(A); }
:EOR OP1  is (cc=1 & aaa=2) ... & OP1          { A = A ^ OP1; resultFlags(A); }
:LDA OP1  is (cc=1 & aaa=5) ... & OP1          { A = OP1; resultFlags(A); }
:STA OP1  is (cc=1 & aaa=4 & bbb!=2) ... & OP1 { OP1 = A; }
:CMP OP1  is (cc=1 & aaa=6) ... & OP1          { local v = OP1; local t = A - v; resultFlags(t); C = (A >= v); }

:CPX OP2  is (op=0xE0 | op=0xE4 | op=0xEC) ... & OP2  { local v = OP2; local t = X - v; resultFlags(t); C = (X >= v); }
:CPY OP2  is (op=0xC0 | op=0xC4 | op=0xCC) ... & OP2  { local v = OP2; local t = Y - v; resultFlags(t); C = (Y >= v); }
:BIT OP2  is (op=0x24 | op=0x2C) ... & OP2            {
   local v = OP2;
   N = (v & 0x80) != 0;
   V = (v & 0x40) != 0;
   Z = (A & v) == 0;
}

:ASL OP2  is (op=0x06 | op=0x0A | op=0x0E | op=0x16 | op=0x1E) ... & OP2 {
   local v = OP2; C = v >> 7; v = v << 1; OP2 = v; resultFlags(v);
}
:ROL OP2  is (op=0x26 | op=0x2A | op=0x2E | op=0x36 | op=0x3E) ... & OP2 {
   local v = OP2; local cin = C; C = v >> 7; v = (v << 1) | cin; OP2 = v; resultFlags(v);
}
:LSR OP2  is (op=0x46 | op=0x4A | op=0x4E | op=0x56 | op=0x5E) ... & OP2 {
   local v = OP2; C = v & 1; v = v >> 1; OP2 = v; resultFlags(v);
}
:ROR OP2  is (op=0x66 | op=0x6A | op=0x6E | op=0x76 | op=0x7E) ... & OP2 {
   local v = OP2; local cin = C << 7; C = v & 1; v = (v >> 1) | cin; OP2 = v; resultFlags(v);
}
:INC OP2  is (op=0xE6 | op=0xEE | op=0xF6 | op=0xFE) ... & OP2  { local v = OP2 + 1; OP2 = v; resultFlags(v); }
:DEC OP2  is (op=0xC6 | op=0xCE | op=0xD6 | op=0xDE) ... & OP2  { local v = OP2 - 1; OP2 = v; resultFlags(v); }

:LDX LDXOP is (op=0xA2 | op=0xA6 | op=0xAE | op=0xB6 | op=0xBE) ... & LDXOP { X = LDXOP; resultFlags(X); }
:LDY OP2   is (op=0xA0 | op=0xA4 | op=0xAC | op=0xB4 | op=0xBC) ... & OP2   { Y = OP2; resultFlags(Y); }
:STX STXOP is (op=0x86 | op=0x8E | op=0x96) ... & STXOP                     { STXOP = X; }
:STY OP2   is (op=0x84 | op=0x8C | op=0x94) ... & OP2                       { OP2 = Y; }

:BPL REL  is op=0x10; REL  { if (N == 0) goto REL; }
:BMI REL  is op=0x30; REL  { if (N != 0) goto REL; }
:BVC REL  is op=0x50; REL  { if (V == 0) goto REL; }
:BVS REL  is op=0x70; REL  { if (V != 0) goto REL; }
:BRA REL  is op=0x80; REL  { goto REL; }
:BCC REL  is op=0x90; REL  { if (C == 0) goto REL; }
:BCS REL  is op=0xB0; REL  { if (C != 0) goto REL; }
:BNE REL  is op=0xD0; REL  { if (Z == 0) goto REL; }
:BEQ REL  is op=0xF0; REL  { if (Z != 0) goto REL; }

:JMP ADDR16    is op=0x4C; ADDR16  { goto ADDR16; }
:JMP (imm16)   is op=0x6C; imm16   {
   local p:2 = imm16;
   local q:2 = (p & 0xff00) | ((p + 1) & 0x00ff);   # 6502 page wrap of the pointer's high byte
   local l:1 = *:1 p;
   local h:1 = *:1 q;
   local target:2 = (zext(h) << 8) | zext(l);
   goto [target];
}
:JSR ADDR16    is op=0x20; ADDR16  { local ret:2 = inst_next - 1; push16(ret); call ADDR16; }
:RTS           is op=0x60          { local t:2 = 0; pull16(t); t = t + 1; return [t]; }
:RTI           is op=0x40          {
   local p:1 = 0; pull8(p); unpackP(p);
   local t:2 = 0; pull16(t);
   return [t];
}
:BRK           is op=0x00          { software_interrupt(); }

:PHA  is op=0x48  { push8(A); }
:PLA  is op=0x68  { pull8(A); resultFlags(A); }
:PHP  is op=0x08  { local p:1 = 0; packP(p); push8(p); }
:PLP  is op=0x28  { local p:1 = 0; pull8(p); unpackP(p); }

:CLC  is op=0x18  { C = 0; }
:SEC  is op=0x38  { C = 1; }
:CLI  is op=0x58  { I = 0; }
:SEI  is op=0x78  { I = 1; }
:CLV  is op=0xB8  { V = 0; }
:CLD  is op=0xD8  { D = 0; }
:SED  is op=0xF8  { D = 1; }
:NOP  is op=0xEA  { }

:INX  is op=0xE8  { X = X + 1; resultFlags(X); }
:INY  is op=0xC8  { Y = Y + 1; resultFlags(Y); }
:DEX  is op=0xCA  { X = X - 1; resultFlags(X); }
:DEY  is op=0x88  { Y = Y - 1; resultFlags(Y); }
:TAX  is op=0xAA  { X = A; resultFlags(X); }
:TAY  is op=0xA8  { Y = A; resultFlags(Y); }
:TXA  is op=0x8A  { A = X; resultFlags(A); }
:TYA  is op=0x98  { A = Y; resultFlags(A); }
:TSX  is op=0xBA  { X = S; resultFlags(X); }
:TXS  is op=0x9A  { S = X; }

################################################################
# MELPS 740 extensions
################################################################

:INC A  is op=0x3A & A  { A = A + 1; resultFlags(A); }
:DEC A  is op=0x1A & A  { A = A - 1; resultFlags(A); }

:BBS^bitn A,REL       is bitn & bbb=0 & cc=3 & A; REL   { local n:1 = bitn; local m:1 = 1 << n; if ((A & m) != 0) goto REL; }
:BBC^bitn A,REL       is bitn & bbb=4 & cc=3 & A; REL   { local n:1 = bitn; local m:1 = 1 << n; if ((A & m) == 0) goto REL; }
:BBS^bitn ZP,REL2     is bitn & bbb=1 & cc=3; ZP; REL2   { local n:1 = bitn; local m:1 = 1 << n; local v:1 = ZP; if ((v & m) != 0) goto REL2; }
:BBC^bitn ZP,REL2     is bitn & bbb=5 & cc=3; ZP; REL2   { local n:1 = bitn; local m:1 = 1 << n; local v:1 = ZP; if ((v & m) == 0) goto REL2; }
:SEB^bitn A           is bitn & bbb=2 & cc=3 & A         { local n:1 = bitn; local m:1 = 1 << n; A = A | m; }
:CLB^bitn A           is bitn & bbb=6 & cc=3 & A         { local n:1 = bitn; local m:1 = 1 << n; A = A & ~m; }
:SEB^bitn ZP          is bitn & bbb=3 & cc=3; ZP         { local n:1 = bitn; local m:1 = 1 << n; local v:1 = ZP; ZP = v | m; }
:CLB^bitn ZP          is bitn & bbb=7 & cc=3; ZP         { local n:1 = bitn; local m:1 = 1 << n; local v:1 = ZP; ZP = v & ~m; }

:LDM "#"imm8,ZP2  is op=0x3C; imm8; ZP2  { ZP2 = imm8; }
:TST ZP           is op=0x64; ZP         { local v:1 = ZP; resultFlags(v); }
:COM ZP           is op=0x44; ZP         { local v:1 = ZP; v = ~v; ZP = v; resultFlags(v); }
:RRF ZP           is op=0x82; ZP         { local v:1 = ZP; ZP = (v << 4) | (v >> 4); }

:JMP (imm8)   is op=0xB2; imm8  {
   local zp:1 = imm8;
   local lo:2 = zext(zp);
   zp = zp + 1;
   local hi:2 = zext(zp);
   local l:1 = *:1 lo;
   local h:1 = *:1 hi;
   local target:2 = (zext(h) << 8) | zext(l);
   goto [target];
}
:JSR (imm8)   is op=0x02; imm8  {
   local zp:1 = imm8;
   local lo:2 = zext(zp);
   zp = zp + 1;
   local hi:2 = zext(zp);
   local l:1 = *:1 lo;
   local h:1 = *:1 hi;
   local target:2 = (zext(h) << 8) | zext(l);
   local ret:2 = inst_next - 1;
   push16(ret);
   call [target];
}
:JSR SPG      is op=0x22; SPG   { local ret:2 = inst_next - 1; push16(ret); call SPG; }

:CLT  is op=0x12  { T = 0; }
:SET  is op=0x32  { T = 1; }
:WIT  is op=0xC2  { wait(); }
:STP  is op=0x42  { stop(); }

# MUL/DIV: never used by the ROM and faulted by cpu740, so not validated (Mitsubishi semantics).
:MUL imm8,X  is op=0x62 & X; imm8  {
   local ea:2 = zext(imm8 + X);
   local prod:2 = zext(A) * zext(*:1 ea);
   A = prod:1;
   *:1 SP = prod(1);
   SP = SP - 1;
}
:DIV imm8,X  is op=0xE2 & X; imm8  {
   local zl:1 = imm8 + X;
   local zh:1 = zl + 1;
   local lo:2 = zext(zl);
   local hi:2 = zext(zh);
   local num:2 = (zext(*:1 hi) << 8) | zext(*:1 lo);
   local den:2 = zext(A);
   local q:2 = num / den;
   local rmd:2 = num % den;
   A = q:1;
   *:1 SP = rmd:1;
   SP = SP - 1;
}
